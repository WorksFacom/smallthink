# Host Ollama (bge-m3 + the exported GGUF model)
OLLAMA_URL=http://host.docker.internal:11434
GEN_MODEL=qwen3-4b-cfm-cot
EMBED_MODEL=bge-m3

# Qdrant on the host (not managed by this compose)
QDRANT_URL=http://host.docker.internal:6333
QDRANT_API_KEY=
COLLECTION=cfm_passages

# Retrieval: training problems show 2–3 passages; below MIN_SCORE a passage is dropped,
# and with no passage left the bot refuses without calling the model
TOP_K=3
MIN_SCORE=0.56

# Passages produced by ../data_pipeline/ingest_cfm.py
PASSAGES_FILE=./data/passages.jsonl

# Batch answer API (docker compose up -d api)
API_PORT=8000
